---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SkillGroups from "../components/SkillGroups.astro";
import ChatWidget from "../components/ChatWidget.astro";
import T from "../components/T.astro";
import { portfolio } from "../data/portfolio";
import "../styles/global.css";

export const prerender = true;
---

<BaseLayout>
  <a class="skip-link" href="#main-content"><T t={{ en: "Skip to content", fa: "رفتن به محتوا" }} /></a>
  <div class="page-shell">
    <SiteHeader />
    <main id="main-content">
      <Hero />

      <section class="about-section section-shell section-space" id="about" aria-labelledby="about-title">
        <div class="about-label">
          <p class="eyebrow"><T t={{ en: "01 / About", fa: "۰۱ / درباره" }} /></p>
          <span class="about-rule" aria-hidden="true"></span>
        </div>
        <div class="about-content">
          <h2 id="about-title">
            <span class="en">Different disciplines.<br /><em>A connected perspective.</em></span>
            <span class="fa" lang="fa">رشته‌های گوناگون.<br /><em>نگاهی پیوسته.</em></span>
          </h2>
          <p><T t={portfolio.about} /></p>
          <a class="text-link" href="#education"><T t={{ en: "Explore education", fa: "مشاهده‌ی تحصیلات" }} /></a>
        </div>
        <div class="about-aside">
          <p class="eyebrow"><T t={{ en: "Personal value", fa: "ارزش شخصی" }} /></p>
          <p class="personal-value"><T t={portfolio.personalValue} /></p>
        </div>
      </section>

      <section class="education-section section-shell section-space" id="education" aria-labelledby="education-title">
        <div class="education-heading">
          <SectionHeading
            id="education-title"
            eyebrow={{ en: "02 / Education", fa: "۰۲ / تحصیلات" }}
            title={{ en: "Education & graduation.", fa: "تحصیلات و فارغ‌التحصیلی." }}
          />
          <p class="education-note"><T t={{ en: "A technical academic foundation, alongside experience in teaching and communication.", fa: "پایه‌ای فنی و دانشگاهی، همراه با تجربه در تدریس و ارتباطات." }} /></p>
        </div>
        <div class="education-layout">
          <div class="education-list">
            {portfolio.education.map((item) => (
              <article class="education-item">
                <div class="education-item-main">
                  <img
                    class="education-logo"
                    src={item.logo}
                    alt={item.logoAlt}
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <h3><T t={item.qualification} /></h3>
                    <p><T t={item.institution} /></p>
                    <span><T t={item.location} /></span>
                  </div>
                </div>
                {"period" in item && item.period && (
                  <span class="education-period"><T t={item.period} /></span>
                )}
              </article>
            ))}
          </div>
          <figure class="graduation-photo">
            <img
              src="/images/graduation.webp"
              alt="Bahar wearing her graduation gown and cap"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <section class="experience-section section-shell section-space" id="experience" aria-labelledby="experience-title">
        <SectionHeading
          id="experience-title"
          eyebrow={{ en: "03 / Experience", fa: "۰۳ / تجربه" }}
          title={{ en: "A career across disciplines.", fa: "مسیری میان رشته‌ها." }}
          description={{
            en: "Experience across teaching, energy, digital projects, and administrative support.",
            fa: "تجربه در تدریس، انرژی، پروژه‌های دیجیتال و پشتیبانی اداری.",
          }}
        />
        <ExperienceTimeline entries={portfolio.experience} />
      </section>

      <section class="work-section section-space" id="work" aria-labelledby="work-title">
        <div class="section-shell">
          <SectionHeading
            id="work-title"
            eyebrow={{ en: "04 / Selected work", fa: "۰۴ / نمونه‌کارها" }}
            title={{ en: "Digital work, made tangible.", fa: "کار دیجیتال، ملموس و دیدنی." }}
            description={{
              en: "Four website projects bringing together layout, content, research, AI-assisted building, and site administration.",
              fa: "چهار پروژه‌ی وب‌سایت که چیدمان، محتوا، پژوهش، ساخت با کمک هوش مصنوعی و مدیریت سایت را کنار هم می‌آورند.",
            }}
          />
          <div class="project-grid">
            {portfolio.projects.map((project, index) => (
              <ProjectCard {...project} index={`0${index + 1}`} featured={index === 0} />
            ))}
          </div>
        </div>
      </section>

      <section class="skills-section section-space" id="skills" aria-labelledby="skills-title">
        <div class="section-shell">
          <SectionHeading
            id="skills-title"
            eyebrow={{ en: "05 / Skills", fa: "۰۵ / مهارت‌ها" }}
            title={{ en: "Skills & strengths.", fa: "مهارت‌ها و توانمندی‌ها." }}
            description={{
              en: "Personal strengths, web and AI tools, sports, and languages.",
              fa: "توانمندی‌های فردی، ابزارهای وب و هوش مصنوعی، ورزش و زبان‌ها.",
            }}
          />
          <SkillGroups groups={portfolio.skills} />
        </div>
      </section>

      <section class="hobbies-section section-shell section-space" id="outside-of-work" aria-labelledby="hobbies-title">
        <div class="hobbies-layout">
          <div class="hobbies-copy">
            <SectionHeading
              id="hobbies-title"
              eyebrow={{ en: "06 / Outside of work", fa: "۰۶ / بیرون از کار" }}
              title={{ en: "Hobbies & interests.", fa: "سرگرمی‌ها و علایق." }}
              description={{
                en: "Activities that make space for creativity, movement, and exploring new places.",
                fa: "فعالیت‌هایی که برای خلاقیت، تحرک و کشف جاهای تازه فضا می‌سازند.",
              }}
            />
            <ul class="hobbies-list">
              {portfolio.hobbies.map((hobby) => <li><T t={hobby} /></li>)}
            </ul>
          </div>
          <div class="hobbies-collage" role="group" aria-label="Bahar enjoying activities outside work">
            <img
              class="hobby-photo"
              src="/images/hobbies/tennis.webp"
              alt="Bahar holding a tennis racket on a court"
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <img
              class="hobby-photo"
              src="/images/hobbies/nature-walk.webp"
              alt="Bahar outdoors on a tree-lined path"
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <img
              class="hobby-photo"
              src="/images/hobbies/singing.webp"
              alt="Bahar singing into a microphone"
              width="900"
              height="1040"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
  <ChatWidget />
</BaseLayout>
