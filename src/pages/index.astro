---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SkillGroups from "../components/SkillGroups.astro";
import ChatWidget from "../components/ChatWidget.astro";
import { portfolio } from "../data/portfolio";
import "../styles/global.css";

export const prerender = true;
---

<BaseLayout>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="page-shell">
    <SiteHeader />
    <main id="main-content">
      <Hero />

      <section class="about-section section-shell section-space" id="about" aria-labelledby="about-title">
        <div class="about-label">
          <p class="eyebrow">01 / About</p>
          <span class="about-rule" aria-hidden="true"></span>
        </div>
        <div class="about-content">
          <h2 id="about-title">Different disciplines.<br /><em>A connected perspective.</em></h2>
          <p>{portfolio.about}</p>
          <a class="text-link" href="#education">Explore education</a>
        </div>
        <div class="about-aside">
          <p class="eyebrow">Personal value</p>
          <p class="personal-value">{portfolio.personalValue}</p>
        </div>
      </section>

      <section class="education-section section-shell section-space" id="education" aria-labelledby="education-title">
        <div class="education-heading">
          <SectionHeading
            id="education-title"
            eyebrow="02 / Education"
            title="Education & graduation."
          />
          <p class="education-note">A technical academic foundation, alongside experience in teaching and communication.</p>
        </div>
        <div class="education-layout">
          <div class="education-list">
            {portfolio.education.map((item) => (
              <article class="education-item">
                <div class="education-item-main">
                  <img
                    class="education-logo"
                    src={item.logo}
                    alt={item.logoAlt}
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <h3>{item.qualification}</h3>
                    <p>{item.institution}</p>
                    <span>{item.location}</span>
                  </div>
                </div>
                {"period" in item && item.period && (
                  <span class="education-period">{item.period}</span>
                )}
              </article>
            ))}
          </div>
          <figure class="graduation-photo">
            <img
              src="/images/graduation.webp"
              alt="Bahar wearing her graduation gown and cap"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <section class="experience-section section-shell section-space" id="experience" aria-labelledby="experience-title">
        <SectionHeading
          id="experience-title"
          eyebrow="03 / Experience"
          title="A career across disciplines."
          description="Experience across teaching, energy, digital projects, and administrative support."
        />
        <ExperienceTimeline entries={portfolio.experience} />
      </section>

      <section class="work-section section-space" id="work" aria-labelledby="work-title">
        <div class="section-shell">
          <SectionHeading
            id="work-title"
            eyebrow="04 / Selected work"
            title="Digital work, made tangible."
            description="Three website projects bringing together layout, content, research, AI-assisted building, and site administration."
          />
          <div class="project-grid">
            {portfolio.projects.map((project, index) => (
              <ProjectCard {...project} index={`0${index + 1}`} featured={index === 2} />
            ))}
          </div>
        </div>
      </section>

      <section class="skills-section section-space" id="skills" aria-labelledby="skills-title">
        <div class="section-shell">
          <SectionHeading
            id="skills-title"
            eyebrow="05 / Skills"
            title="Skills & strengths."
            description="Personal strengths, web and AI tools, sports, and languages."
          />
          <SkillGroups groups={portfolio.skills} />
        </div>
      </section>

      <section class="hobbies-section section-shell section-space" id="outside-of-work" aria-labelledby="hobbies-title">
        <div class="hobbies-layout">
          <div class="hobbies-copy">
            <SectionHeading
              id="hobbies-title"
              eyebrow="06 / Outside of work"
              title="Hobbies & interests."
              description="Activities that make space for creativity, movement, and exploring new places."
            />
            <ul class="hobbies-list">
              {portfolio.hobbies.map((hobby) => <li>{hobby}</li>)}
            </ul>
          </div>
          <div class="hobbies-collage" role="group" aria-label="Bahar enjoying activities outside work">
            <img
              class="hobby-photo"
              src="/images/hobbies/tennis.webp"
              alt="Bahar holding a tennis racket on a court"
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <img
              class="hobby-photo"
              src="/images/hobbies/nature-walk.webp"
              alt="Bahar outdoors on a tree-lined path"
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <img
              class="hobby-photo"
              src="/images/hobbies/singing.webp"
              alt="Bahar singing into a microphone"
              width="900"
              height="1040"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
  <ChatWidget />
</BaseLayout>
