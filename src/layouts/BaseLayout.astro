---
import "@fontsource-variable/fraunces/soft.css";
import "@fontsource-variable/fraunces/soft-italic.css";
import "@fontsource-variable/manrope";
import "@fontsource-variable/vazirmatn";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bahar Emampour | Multidisciplinary Professional",
  description = "Bahar Emampour’s portfolio spanning creativity, engineering, education, digital work, and art — teaching, website projects, research, and content creation.",
} = Astro.props;
const canonicalUrl = new URL("/", Astro.site ?? "https://baharemampour.com");
const socialImageUrl = new URL("/images/portrait.jpg", canonicalUrl);
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15648a" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Portrait of Bahar Emampour" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved language (or a Persian browser) before the page paints, so it never flashes English first.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("site-lang"); } catch (e) {}
        var lang = saved === "fa" || (!saved && (navigator.language || "").indexOf("fa") === 0) ? "fa" : "en";
        var root = document.documentElement;
        root.dataset.lang = lang;
        root.lang = lang;
        root.dir = lang === "fa" ? "rtl" : "ltr";
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
