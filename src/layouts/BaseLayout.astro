---
import "@fontsource-variable/fraunces/soft.css";
import "@fontsource-variable/fraunces/soft-italic.css";
import "@fontsource-variable/manrope";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bahar Emampour | Multidisciplinary Professional",
  description = "Bahar Emampour’s portfolio spanning creativity, engineering, education, digital work, and art — teaching, website projects, research, and content creation.",
} = Astro.props;
const canonicalUrl = new URL("/", Astro.site ?? "https://baharemampour.com");
const socialImageUrl = new URL("/images/portrait.jpg", canonicalUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6fbfe" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Portrait of Bahar Emampour" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
