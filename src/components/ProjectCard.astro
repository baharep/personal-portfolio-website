---
import T from "./T.astro";

type Text = { readonly en: string; readonly fa: string };
interface Props {
  name: string;
  category: Text;
  url: string;
  logo: string;
  logoAlt: string;
  logoWidth: number;
  logoHeight: number;
  description: Text;
  index: string;
  featured?: boolean;
}

const {
  name,
  category,
  url,
  logo,
  logoAlt,
  logoWidth,
  logoHeight,
  description,
  index,
  featured = false,
} = Astro.props;
---

<article class={featured ? "project-card project-card-featured" : "project-card"}>
  <div class="project-card-top">
    <span class="project-index">{index}</span>
    <span class="project-category"><T t={category} /></span>
  </div>
  <h3 dir="ltr">{name}</h3>
  <p><T t={description} /></p>
  <a class="project-link" href={url} target="_blank" rel="noreferrer noopener">
    <span class="en">Visit {name} <span class="project-link-note">(opens in a new tab)</span></span><span class="fa" lang="fa">مشاهده‌ی <bdi>{name}</bdi> <span class="project-link-note">(در زبانه‌ی جدید)</span></span>
  </a>
  <img
    class="project-logo"
    src={logo}
    alt={logoAlt}
    width={logoWidth}
    height={logoHeight}
    loading="lazy"
    decoding="async"
  />
</article>
