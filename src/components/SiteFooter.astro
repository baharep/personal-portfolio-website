---
import { portfolio } from "../data/portfolio";
import T from "./T.astro";
---

<footer class="site-footer" id="contact">
  <div class="footer-copy">
    <p class="eyebrow"><T t={{ en: "A thoughtful next step", fa: "قدم بعدی" }} /></p>
    <h2>
      <span class="en">Let’s start a <em>conversation.</em></span>
      <span class="fa" lang="fa">بیایید <em>گفت‌وگو</em> را شروع کنیم.</span>
    </h2>
    <p><T t={{ en: "Connect through my website and social profiles below.", fa: "از طریق وب‌سایت و شبکه‌های اجتماعی من در ارتباط باشید." }} /></p>
  </div>
  <div class="footer-links">
    {portfolio.socialLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noreferrer noopener"
        aria-label={`Open Bahar Emampour’s ${link.label} in a new tab`}
      >
        <span class="social-icon-frame" aria-hidden="true">
          {link.label === "LinkedIn" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="2.5" width="19" height="19" rx="3" />
              <path d="M7.5 10v7m0-10v.01M11 17v-4a2 2 0 0 1 4 0v4m-4-4v-3" />
            </svg>
          )}
          {link.label === "Instagram" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
            </svg>
          )}
          {link.label === "Website" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" />
            </svg>
          )}
        </span>
        <span><T t={link.name} /></span>
      </a>
    ))}
  </div>
  <div class="footer-links footer-offer-row">
    <a class="footer-offer" href="https://order-portfolio-website.vercel.app" target="_blank" rel="noreferrer noopener">
      <span class="social-icon-frame" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2.5" />
          <path d="M3 8.5h18M6 6.3h.01M8.3 6.3h.01M7 13h7M7 16h4" />
        </svg>
      </span>
      <span><T t={{ en: "Want a website like this?", fa: "وب‌سایتی مثل این می‌خواهید؟" }} /></span>
    </a>
  </div>
  <div class="footer-bottom">
    <a class="brand footer-brand" href="#home" aria-label="Bahar Emampour, back to the top">
      <img class="brand-signature" src="/images/logos/bahar-signature.svg" alt="" width="247" height="75" />
      <span class="brand-surname">Emampour</span>
    </a>
    <span><T t={{ en: "Designed by Bahar Emampour.", fa: "طراحی: بهار امام‌پور" }} /></span>
    <a href="#home"><T t={{ en: "Back to top", fa: "بازگشت به بالا" }} /></a>
  </div>
</footer>
