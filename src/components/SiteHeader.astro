---
const links = [
  { id: "about", label: "About me" },
  { id: "education", label: "Education" },
  { id: "experience", label: "Experiences" },
  { id: "work", label: "Selected work" },
  { id: "skills", label: "Skills" },
  { id: "outside-of-work", label: "Outside of work" },
  { id: "contact", label: "Contact" },
];
---

<header class="site-header" id="site-header">
  <a class="brand" href="#home" aria-label="Bahar Emampour home">
    <img class="brand-signature" src="/images/logos/bahar-signature.svg" alt="" width="247" height="75" />
  </a>
  <nav aria-label="Main navigation">
    {links.map((link) => <a href={`#${link.id}`} data-nav-link>{link.label}</a>)}
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("#site-header");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")];
  const root = document.documentElement;

  // Keep the anchor offset equal to the real header height (it changes when the nav wraps).
  const syncHeaderHeight = () => {
    if (header) root.style.setProperty("--header-height", `${header.offsetHeight}px`);
  };
  syncHeaderHeight();
  if (header) new ResizeObserver(syncHeaderHeight).observe(header);

  const nav = document.querySelector<HTMLElement>("#site-header nav");
  let activeId = "";

  // Only the nav row may scroll sideways to reveal the active link (narrow screens).
  // Never use scrollIntoView here: inside a sticky header it can scroll the whole page.
  const revealInNav = (link: HTMLAnchorElement) => {
    if (!nav || nav.scrollWidth <= nav.clientWidth) return;
    const left = link.offsetLeft - nav.offsetLeft;
    const right = left + link.offsetWidth;
    if (left < nav.scrollLeft) nav.scrollTo({ left: left - 8 });
    else if (right > nav.scrollLeft + nav.clientWidth) nav.scrollTo({ left: right - nav.clientWidth + 8 });
  };

  const setActive = (id: string) => {
    if (id === activeId) return;
    activeId = id;
    for (const link of links) {
      const isActive = link.hash === `#${id}`;
      link.classList.toggle("is-active", isActive);
      if (isActive) {
        link.setAttribute("aria-current", "location");
        revealInNav(link);
      } else {
        link.removeAttribute("aria-current");
      }
    }
  };

  let lockUntil = 0;
  for (const link of links) {
    link.addEventListener("click", () => {
      setActive(link.hash.slice(1));
      lockUntil = Date.now() + 900;
    });
  }

  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);

  const updateFromScroll = () => {
    if (Date.now() < lockUntil) return;
    const offset = (header?.offsetHeight ?? 0) + window.innerHeight * 0.25;
    let current = "";
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= offset) current = section.id;
    }
    if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
      current = sections.at(-1)?.id ?? current;
    }
    setActive(current);
  };

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateFromScroll();
        ticking = false;
      });
    },
    { passive: true },
  );
  updateFromScroll();
</script>
