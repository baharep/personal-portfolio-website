---
import { portfolio } from "../data/portfolio";
---

<section class="hero section-shell" id="home" aria-labelledby="hero-title">
  <div class="hero-copy">
    <ul class="discipline-list" aria-label="Areas of work">
      {portfolio.disciplines.map((discipline) => <li>{discipline}</li>)}
    </ul>
    <h1 id="hero-title">
      Multidisciplinary work, shaped by <em>learning and ideas.</em>
    </h1>
    <p class="hero-intro">{portfolio.introduction}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">Explore selected work</a>
      <a class="text-link" href="#contact">Get in touch</a>
    </div>
    <p class="hero-note">Grounded in engineering. Shaped by teaching, digital projects, and art.</p>
  </div>
  <div class="hero-portrait-wrap">
    <span class="portrait-sun" aria-hidden="true"></span>
    <div class="portrait-frame">
      <picture>
        <source srcset="/images/portrait.webp" type="image/webp" />
        <img
          class="hero-portrait"
          src="/images/portrait.jpg"
          alt="Bahar Emampour sitting in a blue café, wearing a cream blazer"
          width="900"
          height="1098"
          fetchpriority="high"
        />
      </picture>
    </div>
    <div class="portrait-caption">
      <span>Independent thinking</span>
      <span class="caption-dot" aria-hidden="true"></span>
      <span>Continuous learning</span>
    </div>
    <span class="portrait-orbit" aria-hidden="true"></span>
  </div>
</section>
