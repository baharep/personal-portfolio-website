---
interface SkillGroup {
  name: string;
  items: readonly string[];
}

interface Props {
  groups: readonly SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="skill-grid">
  {groups.map((group) => (
    <article class="skill-group">
      <h3>{group.name}</h3>
      <ul>
        {group.items.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  ))}
</div>
