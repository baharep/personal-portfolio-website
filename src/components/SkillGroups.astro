---
import T from "./T.astro";

type Text = { readonly en: string; readonly fa: string };
interface SkillGroup {
  name: Text;
  items: readonly Text[];
}

interface Props {
  groups: readonly SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="skill-grid">
  {groups.map((group) => (
    <article class="skill-group">
      <h3><T t={group.name} /></h3>
      <ul>
        {group.items.map((item) => <li><T t={item} /></li>)}
      </ul>
    </article>
  ))}
</div>
